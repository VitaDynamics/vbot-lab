// GetSupportedEmotions — display supported emotion query service
//
// Aorta typed service for ROS2 `/display_node/get_supported_emotions`
// (`vbot_ros2_msgs/peripheral_msgs/srv/GetSupportedEmotions.srv`).

include "schemas/system/aorta_base.fbs";
include "schemas/shared/service_common/status.fbs";

namespace aorta.services.peripheral;

table GetSupportedEmotionsRequest {
  aorta_header: aorta.sys.AortaHeader (id: 0);
}

table GetSupportedEmotionsResponse {
  aorta_header: aorta.sys.AortaHeader (id: 0);
  status: aorta.services.common.ServiceStatus (id: 1);
  message: string (id: 2);
  supported_emotions: [string] (id: 3);
}

root_type GetSupportedEmotionsRequest;

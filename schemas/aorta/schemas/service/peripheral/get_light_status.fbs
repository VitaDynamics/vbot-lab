// GetLightStatus — peripheral RGB light status query service
//
// Aorta typed service for ROS2 `/light_node/status`
// (`vbot_ros2_msgs/peripheral_msgs/srv/GetLightStatus.srv`).

include "schemas/system/aorta_base.fbs";
include "schemas/shared/service_common/status.fbs";

namespace aorta.services.peripheral;

table GetLightStatusRequest {
  aorta_header: aorta.sys.AortaHeader (id: 0);
}

table GetLightStatusResponse {
  aorta_header: aorta.sys.AortaHeader (id: 0);
  status: aorta.services.common.ServiceStatus (id: 1);
  is_enabled: bool = false (id: 2);
  current_mode: ubyte = 0 (id: 3);
  current_red: ubyte = 0 (id: 4);
  current_green: ubyte = 0 (id: 5);
  current_blue: ubyte = 0 (id: 6);
  current_brightness: ubyte = 0 (id: 7);
  current_speed: float = 0.0 (id: 8);
  message: string (id: 9);
}

root_type GetLightStatusRequest;

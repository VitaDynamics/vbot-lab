// Map asset short-operation READ services for slam-related local map assets.
// Write / semantic-mutation short operations live in
// map_asset_admin_service.fbs; long-running upload/download operations are
// defined in action/slam/map_asset/.
//
// The read/write halves were split at file level only (EDU read/write split,
// decision E3): every table/enum name, field name and field id below is
// byte-identical to the pre-split definitions, so the deployed service keys
// /slam/map_asset/{list,get_metadata,set_active_map} are wire-unchanged.

include "schemas/system/aorta_base.fbs";
include "schemas/shared/service_common/status.fbs";

namespace aorta.services.slam;

enum MapAssetScope : ubyte {
  UNSPECIFIED = 0,
  LOCAL = 1,
  REMOTE = 2,
  BOTH = 3,
}

table MapAssetMetadata {
  map_name: string (id: 0);
  version_id: string (id: 1);
  local_map_dir: string (id: 2);
  artifact_paths: [string] (id: 3);
  has_global_map: bool (id: 4);
  size_bytes: ulong (id: 5);
  checksum: string (id: 6);
  created_unix_ms: long (id: 7);
  updated_unix_ms: long (id: 8);
  uploaded_unix_ms: long (id: 9);
  tags: [string] (id: 10);
}

table ListMapsRequest {
  aorta_header: aorta.sys.AortaHeader (id: 0);
  scope: MapAssetScope = LOCAL (id: 1);
  include_artifacts: bool = true (id: 2);
}

table ListMapsResponse {
  aorta_header: aorta.sys.AortaHeader (id: 0);
  status: aorta.services.common.ServiceStatus (id: 1);
  maps: [MapAssetMetadata] (id: 2);
  message: string (id: 3);
}

table GetMapMetadataRequest {
  aorta_header: aorta.sys.AortaHeader (id: 0);
  map_name: string (id: 1);
  version_id: string (id: 2);
  scope: MapAssetScope = LOCAL (id: 3);
}

table GetMapMetadataResponse {
  aorta_header: aorta.sys.AortaHeader (id: 0);
  status: aorta.services.common.ServiceStatus (id: 1);
  metadata: MapAssetMetadata (id: 2);
  message: string (id: 3);
}

table SetActiveMapRequest {
  aorta_header: aorta.sys.AortaHeader (id: 0);
  map_name: string (id: 1);
  version_id: string (id: 2);
}

table SetActiveMapResponse {
  aorta_header: aorta.sys.AortaHeader (id: 0);
  status: aorta.services.common.ServiceStatus (id: 1);
  message: string (id: 2);
  map_name: string (id: 3);
  version_id: string (id: 4);
  map_id: string (id: 5);
  frame_id: string (id: 6);
  revision: ulong = 0 (id: 7);
}

root_type ListMapsRequest;

// ControlEnable — control loop and motor communication pause/resume
//
// `/locomotion/control_enable`: enable=true resumes control; false pauses it.
// Used to coordinate control and motor communication during power transitions.
// The legacy ROS2 std_srvs/SetBool request calls the same value `data`.

include "schemas/system/aorta_base.fbs";
include "schemas/shared/service_common/status.fbs";

namespace aorta.services.locomotion;

table ControlEnableRequest {
  aorta_header: aorta.sys.AortaHeader (id: 0);
  enable: bool = false (id: 1);  // = SetBool.data
}

table ControlEnableResponse {
  aorta_header: aorta.sys.AortaHeader (id: 0);
  status: aorta.services.common.ServiceStatus (id: 1);
  message: string (id: 2);
}

root_type ControlEnableRequest;

// RuntimeControl — runtime control of the currently active locomotion action
//
// Aorta typed service for the `locomotion/runtime_control` channel, served by
// the locomotion service, called by rcp (UWB mobility shortcuts). Aorta-native:
// no ROS2 service counterpart. Runtime controls operate on the currently
// running locomotion action; they never start or replace an action.

include "schemas/system/aorta_base.fbs";
include "schemas/shared/service_common/status.fbs";

namespace aorta.services.locomotion;

// Append-only runtime-control command vocabulary.
enum RuntimeControlCommand : ubyte {
  UNKNOWN = 0,
  TRY_RESUME_PILOT = 1,
  SET_COMMAND_SMOOTHING_OVERRIDE = 2,
  CLEAR_COMMAND_SMOOTHING_OVERRIDE = 3,
}

// Outcome vocabulary shared by all runtime-control commands. Semantic
// contract: APPLIED == the runtime event was dispatched; NOT_APPLICABLE ==
// the current action/state cannot honor the command (e.g. the pilot is not
// the active action or is not in a resumable state); FAILED == the request
// reached the service but could not be executed. CONFLICT means a different
// owner holds the override. ALREADY_APPLIED is reserved vocabulary.
enum RuntimeControlOutcome : ubyte {
  UNSPECIFIED = 0,
  APPLIED = 1,
  ALREADY_APPLIED = 2,
  NOT_APPLICABLE = 3,
  CONFLICT = 4,
  FAILED = 5,
}

table RuntimeControlRequest {
  aorta_header: aorta.sys.AortaHeader (id: 0);
  command: RuntimeControlCommand = UNKNOWN (id: 1);
  // Smoothing commands only: unique caller session, nonempty, at most 128 bytes.
  // SET applies to the active NORMAL policy without changing its configured
  // default or resetting filtering/model history. Another active owner conflicts.
  // CLEAR releases only this owner; action deactivation also releases it.
  // An expired or released lease must not be renewed under the same owner.
  owner: string (id: 2);
  cmd_smoothing_ratio: double = 0 (id: 3); // SET: finite, 0 <= ratio < 1.
  // SET: CLOCK_REALTIME Unix nanoseconds (C++ system_clock), never PHC time.
  // Caller and server must share this clock domain. At validation, remaining
  // time must be > 0 and <= 3 seconds; otherwise INVALID_REQUEST, no clamping.
  // Request 2.5 seconds and renew before expiry, leaving 0.5 seconds below the
  // upper bound. The server converts only the remaining time to a monotonic
  // lease; queueing cannot extend it and stale requests cannot revive it.
  valid_until_ns: ulong = 0 (id: 4);
}

table RuntimeControlResponse {
  aorta_header: aorta.sys.AortaHeader (id: 0);
  status: aorta.services.common.ServiceStatus (id: 1);
  outcome: RuntimeControlOutcome = UNSPECIFIED (id: 2);
  detail: string (id: 3);  // Human-readable diagnostic; stable parsing must not rely on it.
}

root_type RuntimeControlRequest;

// System Power Saving Enable Service
//
// Aorta service schema for `/system/power_saving/enable`.
// Mirrors `std_srvs/srv/SetBool` semantics:
//   - request `bool data` -> enter (true) / exit (false) power-saving mode
//   - response carries Aorta's standard ServiceStatus instead of the
//     ROS2 `bool success` flag (SUCCESS == 0), with an optional message.

include "schemas/system/aorta_base.fbs";
include "schemas/shared/service_common/status.fbs";

namespace aorta.services.system;

table PowerSavingEnableRequest {
  aorta_header: aorta.sys.AortaHeader (id: 0);
  data: bool = false (id: 1);
}

table PowerSavingEnableResponse {
  aorta_header: aorta.sys.AortaHeader (id: 0);
  status: aorta.services.common.ServiceStatus (id: 1);
  message: string (id: 2);
}

root_type PowerSavingEnableRequest;

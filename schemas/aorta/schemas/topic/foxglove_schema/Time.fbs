namespace foxglove;

struct Time {
  /// Represents seconds of UTC time since Unix epoch 1970-01-01T00:00:00Z
  sec:uint32;
  /// Nano-second fractions from 0 to 999,999,999 inclusive
  nsec:uint32;
}
